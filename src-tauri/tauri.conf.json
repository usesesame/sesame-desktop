{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sesame",
  "version": "0.1.0",
  "identifier": "app.usesesame.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run desktop:bundle:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sesame",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "quick-access",
        "title": "Sesame quick access",
        "url": "quick-access.html",
        "width": 460,
        "height": 440,
        "minWidth": 460,
        "minHeight": 440,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "capabilities": ["main-capability", "quick-access-capability"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; base-uri 'self'; form-action 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/sesame-browser-host"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/native-host-uninstall.nsh"
      }
    },
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  }
}
