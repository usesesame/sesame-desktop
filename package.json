{
  "name": "sesame",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "desktop:dev": "vite",
    "desktop:build": "vite build",
    "desktop:build:wdio": "vite build --mode wdio",
    "desktop:version:check": "node tools/version-contract.mjs check",
    "desktop:lint:js": "eslint src vite.config.ts vitest.config.ts tools/version-contract.mjs tools/desktop-boundary-contracts.test.mjs",
    "desktop:contracts": "npm run contracts",
    "desktop:host:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/stage-browser-host.ps1",
    "desktop:lint:rust": "npm run desktop:host:stage && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
    "desktop:check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && npm run desktop:test:unit",
    "desktop:test:unit": "vitest run",
    "desktop:coverage": "vitest run --coverage",
    "desktop:test": "node tools/skip-with-message.mjs \"desktop browser\" \"npm run desktop:build\"",
    "desktop:test:app": "node tools/skip-with-message.mjs \"installed-desktop lifecycle suite\"",
    "desktop:ci": "npm run desktop:version:check && npm run desktop:lint:js && npm run desktop:contracts && npm run desktop:check && npm run desktop:build && npm run desktop:lint:rust && cargo test --manifest-path src-tauri/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml --features sync-preview",
    "desktop:boundary:verify": "node tools/verify-desktop-boundary.mjs --run",
    "browser:fixtures": "node tools/serve-browser-retail-fixtures.mjs",
    "desktop:bundle:prepare": "npm run desktop:build && npm run desktop:host:stage",
    "sync:preview:desktop": "node tools/run-sync-preview-desktop.mjs",
    "sync:preview:test": "cargo test --manifest-path src-tauri/Cargo.toml --lib --features sync-preview",
    "lint:js": "eslint .",
    "lint:all": "npm run lint:js && npm run desktop:lint:rust",
    "contracts": "npm run design:tokens:check && node --test \"tools/*-contracts.test.mjs\" tools/create-static-update-manifest.test.mjs",
    "design:tokens:sync": "node tools/design-tokens.mjs sync",
    "design:tokens:check": "node tools/design-tokens.mjs check",
    "version:sync": "node tools/version-contract.mjs sync",
    "version:check": "node tools/version-contract.mjs check",
    "release:check": "npm run desktop:ci && npm run desktop:host:stage",
    "release:build": "npm run release:check && tauri build --no-bundle",
    "release:bundle:windows:unsigned": "tauri build --bundles nsis",
    "installer:evidence:collect": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/collect-installer-lifecycle-evidence.ps1",
    "installer:evidence:compare": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/compare-installer-lifecycle-evidence.ps1",
    "installer:lab:prepare": "node tools/prepare-installer-vm-pair.mjs",
    "updater:lab:prepare": "node tools/prepare-updater-vm-lab.mjs",
    "updater:lab:serve": "node tools/serve-updater-vm-lab.mjs",
    "updater:lab:verify": "node tools/verify-updater-vm-lab.mjs",
    "release:update-manifest": "node tools/create-static-update-manifest.mjs",
    "release:publish": "node tools/publish-release-candidate.mjs",
    "supply-chain:sbom": "node tools/create-sbom.mjs",
    "tauri": "tauri",
    "tauri:dev:browser": "npm run desktop:host:build && tauri dev",
    "desktop:host:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-browser-host.ps1",
    "desktop:host:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test-extension-native-host.ps1",
    "desktop:host:pipe-test": "node tools/test-browser-host-pipe.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1"
  }
}
