# Sesame uses LF everywhere. .gitattributes already normalises on commit; this
# stops editors reintroducing CRLF in the working tree, which otherwise shows up
# as a whole-file diff on Windows.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.rs]
indent_size = 4

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{ps1,psm1}]
# The Windows staging and release scripts are run by PowerShell, which is
# tolerant of LF but conventionally CRLF. .gitattributes decides what is
# committed; this matches it.
end_of_line = crlf
indent_size = 4

[Makefile]
indent_style = tab
